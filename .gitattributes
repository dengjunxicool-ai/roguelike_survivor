# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.json text eol=lf
*.js text eol=lf
*.md text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
