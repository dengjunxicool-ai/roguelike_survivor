extends "res://tools/verify/qa_app_fixture.gd"
func key(code: int) -> void:
 var e := InputEventKey.new()
 e.keycode = code
 e.physical_keycode = code
 e.pressed = true
 Input.parse_input_event(e)
 await settle(2)
 e = e.duplicate()
 e.pressed = false
 Input.parse_input_event(e)
 await settle(2)
func reach(target: Control) -> bool:
 for step: int in 70:
  if root.gui_get_focus_owner() == target: return true
  await key(KEY_TAB)
 check(false, "keyboard reaches " + target.name)
 return false
func live_focus(screen: Node) -> bool:
 var focused: Control = root.gui_get_focus_owner()
 return focused != null and focused.is_visible_in_tree() and not focused.is_queued_for_deletion() and screen.is_ancestor_of(focused)
func run() -> void:
 root.size = Vector2i(1280,720)
 create_timer(30.0,true).timeout.connect(func() -> void: push_error("QA7 focus timeout"); quit(1))
 SaveManager.set_language_id("zh")
 SaveManager.add_soul_stones(10000)
 for id: StringName in [&"abandoned_dungeon", &"toxic_fog_graveyard", &"lava_temple"]: SaveManager.mark_map_cleared(id)
 app = APP.instantiate()
 root.add_child(app)
 await settle(12)
 ui = app.get_node("UIManager")
 ui.transition_to("META_UPGRADE")
 await settle(8)
 var controller: RefCounted = ui._meta_upgrade_controller
 var id: StringName = StringName(GameData.get_permanent_upgrade_pool()[0].id)
 var buy: Button = buttons(controller._upgrade_list)[0]
 check(await reach(buy), "Tab reaches first real purchase")
 var before: int = SaveManager.get_permanent_upgrade_level(id)
 await key(KEY_ENTER)
 check(SaveManager.get_permanent_upgrade_level(id) == before + 1, "keyboard purchase writes real upgrade")
 var meta_screen: Node = ui._screen_registry.get_screen("META_UPGRADE")
 check(live_focus(meta_screen), "purchase refresh preserves a live keyboard focus")
 check(root.gui_get_focus_owner() != null and root.gui_get_focus_owner().name == StringName("MetaUpgrade_"+String(id)), "purchase keeps corresponding upgrade identity")
 await key(KEY_DOWN)
 check(live_focus(meta_screen), "arrows work immediately after keyboard purchase")
 print("META focus after purchase: ",root.gui_get_focus_owner())
 var maximum: int = int(GameData.get_permanent_upgrade_pool()[0].max_level)
 SaveManager.save_value(SaveManager.SECTION_PERMANENT_UPGRADES,String(id),maximum-1)
 controller.refresh()
 await settle(8)
 var last_purchase: Button = buttons(controller._upgrade_list)[0]
 check(await reach(last_purchase), "keyboard reaches final purchase")
 await key(KEY_ENTER)
 check(SaveManager.get_permanent_upgrade_level(id)==maximum, "final keyboard purchase really reaches maximum")
 var max_focus: Control = root.gui_get_focus_owner()
 check(max_focus is Button and not max_focus.disabled and live_focus(meta_screen), "maxed purchase transfers focus to usable action")
 SaveManager.save_value(SaveManager.SECTION_CURRENCY,SaveManager.KEY_SOUL_STONES,0)
 controller.refresh()
 await settle(8)
 check(root.gui_get_focus_owner() == controller._back_button, "empty wallet keeps fixed return reachable")
 ui.transition_to("TITLE")
 ui.transition_to("CHARACTER_SELECT")
 await settle(8)
 var characters: Node = ui._screen_registry.get_screen("CHARACTER_SELECT")
 check(await reach(characters.find_child("CharacterCard_ranger",true,false)), "Tab reaches ranger selection")
 await key(KEY_ENTER)
 check(ui._character_loadout_controller.selected_character_id == &"ranger", "Enter selects another character")
 check(live_focus(characters), "character selection rebuild preserves keyboard focus")
 check(root.gui_get_focus_owner() != null and root.gui_get_focus_owner().name == &"CharacterCard_ranger", "character rebuild keeps selected ranger identity")
 await key(KEY_DOWN)
 check(live_focus(characters), "arrows continue after switching character")
 print("CHARACTER focus after selection: ",root.gui_get_focus_owner())
 ui._on_loadout_confirmed(&"ranger")
 await settle(8)
 var maps: Node = ui._screen_registry.get_screen("MAP_SELECT")
 check(await reach(maps.find_child("MapCard_toxic_fog_graveyard",true,false)), "Tab reaches another map")
 await key(KEY_ENTER)
 check(ui._map_select_controller.selected_map_id == &"toxic_fog_graveyard", "Enter selects unlocked toxic map")
 check(live_focus(maps), "map selection rebuild preserves keyboard focus")
 check(root.gui_get_focus_owner() != null and root.gui_get_focus_owner().name == &"MapCard_toxic_fog_graveyard", "map rebuild keeps selected toxic map identity")
 await key(KEY_DOWN)
 check(live_focus(maps), "arrows continue after switching map")
 print("MAP focus after selection: ",root.gui_get_focus_owner())
 ui.transition_to("CHARACTER_SELECT")
 ui.transition_to("TITLE")
 ui.transition_to("SETTINGS")
 await settle(8)
 var settings_focus: Control = root.gui_get_focus_owner()
 ui._settings_controller._on_language_selected(1)
 await settle(8)
 check(root.gui_get_focus_owner() == settings_focus and live_focus(ui._screen_registry.get_screen("SETTINGS")), "language refresh of hidden lists does not steal settings focus")
 check(ui._character_loadout_controller.selected_character_id == &"ranger" and ui._map_select_controller.selected_map_id == &"toxic_fog_graveyard", "language refresh retains chosen character and map")
 ui.transition_to("TITLE")
 ui.transition_to("CHARACTER_SELECT")
 await settle(8)
 var quick_card: Button = characters.find_child("CharacterCard_ranger",true,false)
 quick_card.grab_focus()
 ui._character_loadout_controller._select_character(&"ranger")
 ui.transition_to("TITLE")
 await settle(8)
 var escaped_focus: Control = root.gui_get_focus_owner()
 check(escaped_focus == null or ui._screen_registry.get_screen("TITLE").is_ancestor_of(escaped_focus), "quick selection then exit never focuses hidden character page")
 ui.transition_to("CODEX")
 await settle(8)
 var tabs: TabContainer = ui._codex_controller._tabs
 print("CODEX initial focus=",root.gui_get_focus_owner()," tab focus mode=",tabs.get_tab_bar().focus_mode)
 check(await reach(tabs.get_tab_bar()), "Tab reaches codex tabs")
 var prior: int = tabs.current_tab
 await key(KEY_RIGHT)
 check(tabs.current_tab != prior, "arrow changes codex tab")
 await finish()
